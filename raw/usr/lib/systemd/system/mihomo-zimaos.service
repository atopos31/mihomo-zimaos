[Unit]
Description=Mihomo with MetaCubeXD for ZimaOS
Documentation=https://github.com/atopos31/mihomo-zimaos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/mihomo-zimaos/run
ExecStopPost=/usr/lib/mihomo-zimaos/dns-route-watch --cleanup
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
